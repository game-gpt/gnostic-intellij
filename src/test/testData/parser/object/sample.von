# Object 文件示例
ObjectFile {
    version: "1.0",
    object: GameObject {
        name: "Player",
        active: true,
        layer: "Default",
        tag: "Player",
    },
    transform: Transform {
        position: [0, 1, 0],
        rotation: [0, 0, 0, 1],
        scale: [1, 1, 1],
    },
    components: [
        Component {
            type: "MeshRenderer",
            mesh: "assets/meshes/player.obj",
        },
    ],
}
